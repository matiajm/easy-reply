# Copy to .env.local and fill in. NEVER commit .env.local.

# --- AI (Matias) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# true = use the built-in keyword mock instead of calling Claude (works with no key)
MOCK_AI=true

# --- Microsoft Graph / Outlook (Diego) ---
# Register an app in Microsoft Entra ID. Needs delegated permissions: Mail.Read, Mail.Send, offline_access
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# true = read from src/lib/sample-emails.ts and simulate sending
MOCK_GRAPH=true
